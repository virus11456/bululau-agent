{
  "framework": null,
  "installCommand": "npm ci",
  "functions": {
    "api/v1/installations/[installationId]/judgments/[eventId].js": {
      "runtime": "nodejs22.x",
      "maxDuration": 15,
      "includeFiles": "lib/**"
    }
  },
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
