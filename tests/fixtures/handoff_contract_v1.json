      "expect": {
        "logical_exit_intents": 1,
        "total_exit_fills": "5",
        "new_order_while_existing_unresolved": false,
        "protection_qty_after_first_fill": "8",
        "protection_qty_after_final_fill": "5"
      }
    },
    {
      "id": "T04",
      "area": "保本移損",
      "data_class": "synthetic_test_only_not_market_or_performance",
