{
  "schema_version": "handoff-contract-v1",
  "data_class": "全部數字均為合成測試資料；不是行情或績效。",
  "scope": "通用契約fixture；未執行repo回測或產品測試",
  "target_cloud_agent": "bc-06874210-430f-5740-b8ff-eb34b3ce515c",
  "cases": [
    {
      "id": "T01",
      "area": "瘸師弟",
      "data_class": "synthetic_test_only_not_market_or_performance",
      "given": {
        "position_qty": "10",
        "initial_risk_quote": "100",
        "observed_R": "1.5"
      },
      "events": [
        "threshold_reached",
        "repeat_tick"
      ],
      "expect": {
        "close_target_qty": "10",
        "logical_exit_intents": 1,
        "reduce_only": true
      }
    },
    {
      "id": "T02",
      "area": "布鹿流",
      "data_class": "synthetic_test_only_not_market_or_performance",
      "given": {
        "position_qty": "10",
        "observed_R": "1.5",
        "half_exit_done": false
      },
      "events": [
        "threshold_reached",
        "fill_qty_5",
        "restart",
        "repeat_tick"
      ],
      "expect": {
        "total_half_exit_filled_qty": "5",
        "remaining_qty": "5",
        "half_exit_done": true,
        "new_half_exit_intents_after_restart": 0
      }
    },
    {
      "id": "T03",
